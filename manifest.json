{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup/popup.html",
    "default_title": "Anchor"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "description": "Open Anchor",
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Command+Shift+A"
      }
    }
  },
  "description": "Anchor a tab to a tab group: keeps it at the front of the group and puts it back if it leaves.",
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "minimum_chrome_version": "102",
  "name": "Anchor",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "version": "0.3.0",
  "optional_host_permissions": [
    "*://*/*"
  ]
}
